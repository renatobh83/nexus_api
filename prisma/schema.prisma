generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  session            String?
  qrcode             String?
  status             String?
  battery            String?
  plugged            Boolean?
  isActive           Boolean  @default(true)
  isDeleted          Boolean  @default(false)
  retries            Int?     @default(0)
  isDefault          Boolean  @default(false)
  tokenTelegram      String?
  type               String   @default("whatsapp")
  number             String?
  wppUser            String?
  pairingCodeEnabled Boolean  @default(false)
  pairingCode        String?
  phone              Json?
  wabaBSP            String?
  tokenAPI           String?
  tokenHook          String?
  farewellMessage    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tickets            Ticket[]

  @@map("Channel")
}

model IntegrationConfig {
  id              String   @id @default(uuid())
  integrationName String
  clientId        String
  isActive        Boolean  @default(true)
  settings        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([integrationName, clientId])
  @@map("integration_configs")
}

model flows {
  id           String          @id @default(uuid())
  nome         String          @unique
  descricao    String
  flow_json    Json
  ativo        Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  gatilho      String?
  queueId      String?
  executions   FlowExecution[]
  flowTriggers FlowTrigger[]

  @@map("flows")
}

model FlowTrigger {
  id      String  @id @default(uuid())
  flowId  String
  evento  String
  queueId String?
  flow    flows   @relation(fields: [flowId], references: [id])
}

model FlowExecution {
  id            String   @id @default(cuid())
  flowId        String
  currentNodeId String?
  status        String
  context       Json
  flowSnapshot  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ticketId      String?
  moduleName    String
  flow          flows    @relation(fields: [flowId], references: [id])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  role         String
  isActive     Boolean   @default(true)
  isOnline     Boolean   @default(false)
  lastLogin    DateTime?
  lastLogout   DateTime?
  lastOnline   DateTime?
  passwordHash String?
  tickets      Ticket[]  @relation("TicketToUser")

  @@map("Users")
}

model ServiceHours {
  id        String  @id @default(uuid())
  queueId   String?
  dayOfWeek Int
  startTime String
  endTime   String
  enabled   Boolean @default(true)
  timezone  String  @default("America/Sao_Paulo")
  queue     Queue?  @relation(fields: [queueId], references: [id])

  @@unique([dayOfWeek, queueId])
}

model Holiday {
  id        String   @id @default(uuid())
  date      String
  name      String
  queueId   String?
  createdAt DateTime @default(now())
  queue     Queue?   @relation(fields: [queueId], references: [id])

  @@unique([date, queueId])
}

model Queue {
  id           String         @id @default(uuid())
  name         String
  hasHuman     Boolean        @default(true)
  holidays     Holiday[]
  tickets      Ticket[]
  serviceHours ServiceHours[]
}

model Ticket {
  id                   Int       @id @default(autoincrement())
  status               String    @default("pending")
  unreadMessages       Int?
  lastMessage          String?
  answered             Boolean   @default(true)
  isGroup              Boolean   @default(false)
  associatedCalls      Boolean   @default(false)
  isActiveDemand       Boolean   @default(false)
  isFarewellMessage    Boolean   @default(false)
  sendWelcomeFlow      Boolean   @default(true)
  isTransference       Boolean   @default(false)
  lastInteractionBot   DateTime?
  botRetries           Int?
  closedAt             BigInt?
  lastMessageAt        BigInt?
  startedAttendanceAt  BigInt?
  chamadoId            BigInt?
  lastAbsenceMessageAt DateTime?
  chatClient           Boolean?
  socketId             String?
  apiConfig            Json?
  contato              String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  channelId            Int
  isInteraction        Boolean   @default(false)
  owner                String?
  externalRefId        String?   @map("external_ref_id")
  integrationSource    String?   @map("integration_source")
  metadata             Json?     @default("{}")
  userId               String?   @db.Uuid
  isFlow               Boolean   @default(false)
  isBot                Boolean   @default(true)
  queueId              String?
  queue     Queue?    @relation(fields: [queueId], references: [id])
  messages             Message[]
  channel              Channel   @relation(fields: [channelId], references: [id])
  user                 User?     @relation("TicketToUser", fields: [userId], references: [id])

  @@map("Tickets")
}

model Message {
  id             String                 @id @default(uuid()) @db.Uuid
  messageId      String                 @unique
  ack            Int                    @default(1)
  read           Boolean                @default(false)
  fromMe         Boolean                @default(false)
  body           String?
  mediaUrl       String?
  mediaType      String?
  reaction       String?
  reactionFromMe String?
  scheduleDate   DateTime?
  sendType       enum_Messages_sendType @default(chat)
  idFront        String?
  isDeleted      Boolean                @default(false)
  isForwarded    Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  ticketid       Int
  contato        String
  timestamp      BigInt
  from           String?
  hasReaction    Boolean                @default(false)
  isGroupMsg     Boolean                @default(false)
  isNotification Boolean                @default(false)
  quotedMsgId    String?
  to             String
  type           enum_MessageType       @default(chat)
  caption        String?
  chatId         String?
  content        String
  mimetype       String?
  sender         String?
   ticket   Ticket @relation(fields: [ticketid], references: [id], onDelete: Cascade)

  @@unique([messageId, ticketid])
  @@map("Messages")
}

enum enum_MessageType {
  notification
  notification_template
  group_notification
  gp2
  broadcast_notification
  e2e_notification
  call_log
  protocol
  chat
  location
  payment
  vcard
  ciphertext
  multi_vcard
  revoked
  oversized
  groups_v4_invite
  hsm
  template_button_reply
  image
  video
  audio
  ptt
  sticker
  document
  product
  order
  list
  list_response
  buttons_response
  poll_creation
  unknown
}

enum enum_Messages_sendType {
  campaign
  chat
  external
  schedule
  bot
  sync
}


model AiPrompt {
  id          String   @id @default(cuid())

  name        String   @unique
  content     String   @db.Text
  variables   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}