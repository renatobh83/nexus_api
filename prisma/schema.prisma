generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  session            String?
  qrcode             String?
  status             String?
  battery            String?
  plugged            Boolean?
  isActive           Boolean  @default(true)
  isDeleted          Boolean  @default(false)
  retries            Int?     @default(0)
  isDefault          Boolean  @default(false)
  tokenTelegram      String?
  type               String   @default("whatsapp")
  number             String?
  wppUser            String?
  pairingCodeEnabled Boolean  @default(false)
  pairingCode        String?
  phone              Json?
  wabaBSP            String?
  tokenAPI           String?
  tokenHook          String?
  farewellMessage    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tickets            Ticket[]

  @@map("Channel")
}

model Ticket {
  id                   Int       @id @default(autoincrement())
  status               String    @default("pending")
  unreadMessages       Int?
  lastMessage          String?
  answered             Boolean   @default(true)
  isGroup              Boolean   @default(false)
  associatedCalls      Boolean   @default(false)
  isActiveDemand       Boolean   @default(false)
  isFarewellMessage    Boolean   @default(false)
  sendWelcomeFlow      Boolean   @default(true)
  isTransference       Boolean   @default(false)
  lastInteractionBot   DateTime?
  botRetries           Int?
  closedAt             BigInt?
  lastMessageAt        BigInt?
  startedAttendanceAt  BigInt?
  chamadoId            BigInt?
  lastAbsenceMessageAt DateTime?
  chatClient           Boolean?
  socketId             String?
  stepChatFlow         String?
  chatFlowStatus       String    @default("not_started")
  apiConfig            Json?
  contato              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  channelId            Int?
  isInteraction        Boolean   @default(false)
  messages             Message[]
  channel              Channel?  @relation(fields: [channelId], references: [id])

  @@map("Tickets")
}

model Message {
  id             String                 @id @default(uuid()) @db.Uuid
  messageId      String                 @unique
  ack            Int                    @default(1)
  status         String
  wabaMediaId    String?
  read           Boolean                @default(false)
  fromMe         Boolean                @default(false)
  body           String
  mediaUrl       String?
  mediaType      String?
  reaction       String?
  reactionFromMe String?
  timestamp      BigInt?
  scheduleDate   DateTime?
  sendType       enum_Messages_sendType @default(chat)
  idFront        String?
  isDeleted      Boolean                @default(false)
  isForwarded    Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  ticketid       Int?
  contato        String
  ticket         Ticket?                @relation(fields: [ticketid], references: [id])

  @@unique([messageId, ticketid])
  @@map("Messages")
}

enum enum_Messages_sendType {
  campaign
  chat
  external
  schedule
  bot
  sync
}
