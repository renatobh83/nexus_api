generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Channel {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  session            String?
  qrcode             String?
  status             String?
  battery            String?
  plugged            Boolean?
  isActive           Boolean  @default(true)
  isDeleted          Boolean  @default(false)
  retries            Int?     @default(0)
  isDefault          Boolean  @default(false)
  tokenTelegram      String?
  type               String   @default("whatsapp")
  number             String?
  wppUser            String?
  pairingCodeEnabled Boolean  @default(false)
  pairingCode        String?
  phone              Json?
  wabaBSP            String?
  tokenAPI           String?
  tokenHook          String?
  farewellMessage    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tickets            Ticket[]

  @@map("Channel")
}
model IntegrationConfig {
  id              String    @id @default(uuid())
  integrationName String    @unique // Ex: 'scheduling_api', 'crm_integration'
  clientId        String?   // Opcional: para configurações por cliente/tenant
  isActive        Boolean   @default(true)
  settings        Json      // Armazena configurações específicas da integração (chaves, URLs, templates)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("integration_configs") // Nome da tabela no banco de dados
}

model flows {
  id              String    @id @default(uuid())
  nome            String    @unique
  descricao       String
  flow_json       Json
  gatilho     String?
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  executions    FlowExecution[]
  flowTriggers FlowTrigger[]
  queueId   String?
  @@map("flows") // Nome da tabela no banco de dados
}
model FlowTrigger {
  id       String @id @default(uuid())
  flowId   String
  evento   String
  queueId  String?
  flow     flows @relation(fields: [flowId], references: [id])
}
model FlowExecution {
  id            String   @id @default(cuid())
  flowId        String
  currentNodeId String?
  status        String
  context       Json
  flowSnapshot  Json
  moduleName    String
  ticketId      String?
  flow          flows    @relation(fields: [flowId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model User {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  email          String   @unique
  role           String
  isActive       Boolean  @default(true)
  passwordHash   String?
  lastLogin      DateTime?
  lastOnline     DateTime?
  lastLogout     DateTime?
  isOnline       Boolean  @default(false)

  tickets        Ticket[] @relation("TicketToUser")

  @@map("Users")
}

model Ticket {
  id                   Int       @id @default(autoincrement())
  status               String    @default("pending")
  unreadMessages       Int?
  lastMessage          String?
  answered             Boolean   @default(true)
  isGroup              Boolean   @default(false)
  associatedCalls      Boolean   @default(false)
  isActiveDemand       Boolean   @default(false)
  isFarewellMessage    Boolean   @default(false)
  sendWelcomeFlow      Boolean   @default(true)
  isTransference       Boolean   @default(false)
  lastInteractionBot   DateTime?
  botRetries           Int?
  closedAt             BigInt?
  lastMessageAt        BigInt?
  startedAttendanceAt  BigInt?
  chamadoId            BigInt?
  lastAbsenceMessageAt DateTime?
  chatClient           Boolean?
  socketId             String?
  isFlow               Boolean   @default(false)
  apiConfig            Json?

  contato              String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  channelId            Int
  isInteraction        Boolean   @default(false)
  owner                String?

  messages             Message[]

  channel              Channel   @relation(fields: [channelId], references: [id])

  // RELAÇÃO
  user                 User?     @relation("TicketToUser", fields: [userId], references: [id])
  userId               String?   @db.Uuid

  integrationSource    String?   @map("integration_source")
  externalRefId        String?   @map("external_ref_id")
  metadata             Json?     @default("{}")

  @@map("Tickets")
}
model Message {
  id             String                 @id @default(uuid()) @db.Uuid
  messageId      String                 @unique
  ack            Int                    @default(1)
  read           Boolean                @default(false)
  fromMe         Boolean                @default(false)
  body           String?
  mediaUrl       String?
  mediaType      String?
  reaction       String?
  reactionFromMe String?
  scheduleDate   DateTime?
  sendType       enum_Messages_sendType @default(chat)
  idFront        String?
  isDeleted      Boolean                @default(false)
  isForwarded    Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  ticketid       Int
  contato        String
  timestamp      BigInt
  from           String?
  hasReaction    Boolean                @default(false)
  isGroupMsg     Boolean                @default(false)
  isNotification Boolean                @default(false)
  to             String
  type           enum_MessageType       @default(chat)
  caption        String?
  sender        String?
  chatId         String?
  content        String
  mimetype       String?
  ticket         Ticket                 @relation(fields: [ticketid], references: [id])

  @@unique([messageId, ticketid])
  @@map("Messages")
}

enum enum_MessageType {
  notification
  notification_template
  group_notification
  gp2
  broadcast_notification
  e2e_notification
  call_log
  protocol
  chat
  location
  payment
  vcard
  ciphertext
  multi_vcard
  revoked
  oversized
  groups_v4_invite
  hsm
  template_button_reply
  image
  video
  audio
  ptt
  sticker
  document
  product
  order
  list
  list_response
  buttons_response
  poll_creation
  unknown
}

enum enum_Messages_sendType {
  campaign
  chat
  external
  schedule
  bot
  sync
}
